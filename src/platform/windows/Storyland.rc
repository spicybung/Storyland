VS_VERSION_INFO VERSIONINFO
 FILEVERSION STORYLAND_VERSION_RESOURCE_NUMBER
 PRODUCTVERSION STORYLAND_VERSION_RESOURCE_NUMBER
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reigns Studios\0"
            VALUE "FileDescription", "Storyland - GTA Stories file analyzer, editor, and viewer\0"
            VALUE "FileVersion", STORYLAND_VERSION_RESOURCE_STRING
            VALUE "InternalName", "Storyland\0"
            VALUE "LegalCopyright", "Storyland contributors\0"
            VALUE "OriginalFilename", "Storyland.exe\0"
            VALUE "ProductName", "Storyland\0"
            VALUE "ProductVersion", STORYLAND_VERSION_RESOURCE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
