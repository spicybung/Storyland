    {"vcs.domo_arigato.opening.ru.010", "vcs.lance_vance", "reassuring", u8"\u042f \u0437\u0430\u043d\u044f\u043b \u043d\u0430\u043c \u0434\u0435\u043d\u0435\u0433 \u0443 \u0420\u0438\u043a\u0430\u0440\u0434\u043e. \u041c\u044b \u0432\u0441\u0451 \u0432\u0435\u0440\u043d\u0451\u043c, \u044f\u0441\u043d\u043e?", "ru"},
    {"vcs.domo_arigato.opening.ru.011", "vcs.victor_vance", "angry", u8"\u0427\u0442\u043e \u0442\u044b \u043e\u043f\u044f\u0442\u044c \u043d\u0430\u0442\u0432\u043e\u0440\u0438\u043b?", "ru"},
    {"vcs.domo_arigato.opening.ru.012", "vcs.lance_vance", "neutral", u8"\u042f \u0432\u043b\u043e\u0436\u0438\u043b \u0438\u0445 \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u0432 \u0434\u0435\u043b\u043e.", "ru"},
    {"vcs.domo_arigato.opening.ru.013", "vcs.lance_vance", "reassuring", u8"\u041f\u0440\u043e\u0441\u0442\u0438, \u0420\u0438\u043a\u0430\u0440\u0434\u043e, \u0434\u0435\u0442\u043a\u0430, \u043d\u043e \u0431\u0440\u0430\u0442\u044c\u044f \u0438\u043d\u043e\u0433\u0434\u0430 \u043b\u044e\u0431\u044f\u0442 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u043a\u0442\u043e \u0442\u0443\u0442 \u0433\u043b\u0430\u0432\u043d\u044b\u0439.", "ru"},
    {"vcs.domo_arigato.opening.ru.014", "vcs.ricardo_diaz", "neutral", u8"\u0417\u043d\u0430\u044e... \u041f\u043e\u0442\u043e\u043c\u0443 \u044f \u0441\u0432\u043e\u0435\u0433\u043e \u0438 \u0443\u0431\u0438\u043b. \u041f\u0430\u0440\u043d\u0438, \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e.", "ru"},
    {"vcs.domo_arigato.opening.ru.015", "vcs.ricardo_diaz", "neutral", u8"\u041f\u0440\u043e\u0441\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0434\u043b\u044f \u043c\u0435\u043d\u044f \u0442\u043e \u0434\u0435\u043b\u043e, \u0438 \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0445\u043e\u0440\u043e\u0448\u043e. \u041f\u043e\u043a\u0430 \u0447\u0442\u043e.", "ru"},
    {"vcs.domo_arigato.opening.ru.016", "vcs.victor_vance", "urgent", u8"\u041e \u0447\u0451\u043c \u043e\u043d \u0433\u043e\u0432\u043e\u0440\u0438\u0442?", "ru"},
    {"vcs.domo_arigato.opening.ru.017", "vcs.lance_vance", "reassuring", u8"\u0421\u043b\u0443\u0448\u0430\u0439, \u0420\u0438\u043a\u0430\u0440\u0434\u043e \u0445\u043e\u0447\u0435\u0442, \u0447\u0442\u043e\u0431\u044b \u043c\u044b \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0438\u043b\u0438 \u0432\u0441\u0435 \u043e\u0431\u043b\u0438\u0433\u0430\u0446\u0438\u0438 \u0410\u0440\u043c\u0430\u043d\u0434\u043e \u041c\u0435\u043d\u0434\u0435\u0441\u0430 \u043d\u0430 \u043f\u0440\u0435\u0434\u044a\u044f\u0432\u0438\u0442\u0435\u043b\u044f.", "ru"},
    {"vcs.domo_arigato.opening.ru.018", "vcs.lance_vance", "reassuring", u8"\u0417\u043d\u0430\u044e, \u0437\u0432\u0443\u0447\u0438\u0442 \u0440\u0438\u0441\u043a\u043e\u0432\u0430\u043d\u043d\u043e, \u043d\u043e... \u0414\u043e\u0432\u0435\u0440\u044c\u0441\u044f \u043c\u043d\u0435! \u0412\u0441\u0451 \u0441\u0445\u0432\u0430\u0447\u0435\u043d\u043e... \u042f \u0432\u0435\u0434\u044c \u0443\u0436\u0435 \u043c\u0438\u043b\u043b\u0438\u043e\u043d \u0440\u0430\u0437 \u0442\u0430\u043a \u0434\u0435\u043b\u0430\u043b.", "ru"},
    {"vcs.domo_arigato.opening.ru.019", "vcs.lance_vance", "quiet", u8"\u0414\u0430\u0432\u0430\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u0437\u0430\u0436\u0436\u0451\u043c, \u0434\u0435\u0442\u043a\u0430... \u041d\u0443, \u0437\u043d\u0430\u0435\u0448\u044c... \u041f\u0440\u043e\u0441\u0442\u043e... \u0437\u0430\u0436\u0436\u0451\u043c.", "ru"},
