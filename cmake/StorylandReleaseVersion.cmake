include_guard(GLOBAL)

get_filename_component(STORYLAND_RELEASE_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(STORYLAND_RELEASE_VERSION_FILE "${STORYLAND_RELEASE_SOURCE_ROOT}/STORYLAND_VERSION.txt")
if(NOT EXISTS "${STORYLAND_RELEASE_VERSION_FILE}")
    message(FATAL_ERROR "STORYLAND_VERSION.txt is missing from the source root.")
endif()
file(READ "${STORYLAND_RELEASE_VERSION_FILE}" STORYLAND_APPLICATION_VERSION)
string(STRIP "${STORYLAND_APPLICATION_VERSION}" STORYLAND_APPLICATION_VERSION)
if(NOT STORYLAND_APPLICATION_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "STORYLAND_VERSION.txt must contain one numeric major.minor.patch version.")
endif()
set(STORYLAND_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(STORYLAND_VERSION_MINOR "${CMAKE_MATCH_2}")
set(STORYLAND_VERSION_PATCH "${CMAKE_MATCH_3}")
if(STORYLAND_VERSION_MAJOR GREATER 2146 OR STORYLAND_VERSION_MINOR GREATER 99 OR STORYLAND_VERSION_PATCH GREATER 99)
    message(FATAL_ERROR "The version exceeds Storyland's Android versionCode component ranges.")
endif()
math(EXPR STORYLAND_ANDROID_VERSION_CODE
    "${STORYLAND_VERSION_MAJOR} * 1000000 + ${STORYLAND_VERSION_MINOR} * 10000 + ${STORYLAND_VERSION_PATCH} * 100")

foreach(STORYLAND_METADATA_NAME IN ITEMS BUILD_INFO.json vcpkg.json)
    file(READ "${STORYLAND_RELEASE_SOURCE_ROOT}/${STORYLAND_METADATA_NAME}" STORYLAND_METADATA_JSON)
    if(STORYLAND_METADATA_NAME STREQUAL "vcpkg.json")
        set(STORYLAND_METADATA_VERSION_KEY "version-string")
    else()
        set(STORYLAND_METADATA_VERSION_KEY "version")
    endif()
    string(JSON STORYLAND_METADATA_VERSION ERROR_VARIABLE STORYLAND_METADATA_ERROR
        GET "${STORYLAND_METADATA_JSON}" "${STORYLAND_METADATA_VERSION_KEY}")
    if(STORYLAND_METADATA_ERROR OR NOT STORYLAND_METADATA_VERSION STREQUAL STORYLAND_APPLICATION_VERSION)
        message(FATAL_ERROR "${STORYLAND_METADATA_NAME} must match STORYLAND_VERSION.txt (${STORYLAND_APPLICATION_VERSION}).")
    endif()
endforeach()

file(READ "${STORYLAND_RELEASE_SOURCE_ROOT}/android/AndroidManifest.xml" STORYLAND_ANDROID_MANIFEST)
string(REGEX MATCH "android:versionName=\"([^\"]+)\"" STORYLAND_ANDROID_NAME_MATCH "${STORYLAND_ANDROID_MANIFEST}")
set(STORYLAND_ANDROID_MANIFEST_VERSION "${CMAKE_MATCH_1}")
string(REGEX MATCH "android:versionCode=\"([0-9]+)\"" STORYLAND_ANDROID_CODE_MATCH "${STORYLAND_ANDROID_MANIFEST}")
set(STORYLAND_ANDROID_MANIFEST_CODE "${CMAKE_MATCH_1}")
if(NOT STORYLAND_ANDROID_MANIFEST_VERSION STREQUAL STORYLAND_APPLICATION_VERSION OR
   NOT STORYLAND_ANDROID_MANIFEST_CODE STREQUAL "${STORYLAND_ANDROID_VERSION_CODE}")
    message(FATAL_ERROR "AndroidManifest.xml versionName/versionCode must match STORYLAND_VERSION.txt.")
endif()

if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${STORYLAND_RELEASE_VERSION_FILE}"
        "${STORYLAND_RELEASE_SOURCE_ROOT}/BUILD_INFO.json"
        "${STORYLAND_RELEASE_SOURCE_ROOT}/vcpkg.json"
        "${STORYLAND_RELEASE_SOURCE_ROOT}/android/AndroidManifest.xml")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
    configure_file("${CMAKE_CURRENT_LIST_DIR}/storyland_version.h.in"
        "${CMAKE_CURRENT_BINARY_DIR}/generated/storyland_version.h" @ONLY)
endif()
