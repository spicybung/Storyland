include_guard(GLOBAL)

get_filename_component(STORYLAND_DEPENDENCY_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(STORYLAND_VENDOR_DIRECTORY "${STORYLAND_DEPENDENCY_SOURCE_ROOT}/vendors")
set(STORYLAND_VENDOR_MANIFEST "${STORYLAND_VENDOR_DIRECTORY}/manifest.json")
if(NOT EXISTS "${STORYLAND_VENDOR_MANIFEST}")
    message(FATAL_ERROR
        "Storyland vendor metadata is missing: ${STORYLAND_VENDOR_MANIFEST}. "
        "Use the complete source package, including its vendors directory.")
endif()
file(READ "${STORYLAND_VENDOR_MANIFEST}" STORYLAND_DEPENDENCY_MANIFEST)
string(JSON STORYLAND_DEPENDENCY_FORMAT GET "${STORYLAND_DEPENDENCY_MANIFEST}" format)
if(NOT STORYLAND_DEPENDENCY_FORMAT EQUAL 2)
    message(FATAL_ERROR "Unsupported Storyland vendor manifest format.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${STORYLAND_VENDOR_MANIFEST}")

function(storyland_stage_dependency name output_variable)
    if(NOT name MATCHES "^[A-Za-z0-9_-]+$")
        message(FATAL_ERROR "Invalid Storyland vendor name: ${name}")
    endif()
    string(JSON vendor ERROR_VARIABLE vendor_error
        GET "${STORYLAND_DEPENDENCY_MANIFEST}" bundles "${name}")
    if(vendor_error)
        message(FATAL_ERROR "Unknown Storyland vendor: ${name}")
    endif()
    string(JSON root GET "${vendor}" root)
    if(root STREQUAL ".")
        if(NOT name STREQUAL "integration")
            message(FATAL_ERROR "Only the integration inventory may use the vendor root directory.")
        endif()
    elseif(NOT root MATCHES "^[A-Za-z0-9_./-]+$" OR root MATCHES "^/|(^|/)\\.\\.?(/|$)|//")
        message(FATAL_ERROR "Invalid source directory for Storyland vendor ${name}: ${root}")
    endif()
    set(target "${STORYLAND_VENDOR_DIRECTORY}/${root}")
    if(NOT IS_DIRECTORY "${target}")
        message(FATAL_ERROR
            "Storyland vendor source is missing: ${target}. "
            "Restore vendors/${root} from the complete source package or Git checkout.")
    endif()
    string(JSON required_count LENGTH "${vendor}" required_files)
    if(required_count LESS 1)
        message(FATAL_ERROR "Storyland vendor ${name} has no required source files in its manifest.")
    endif()
    math(EXPR required_last "${required_count} - 1")
    foreach(index RANGE ${required_last})
        string(JSON required GET "${vendor}" required_files ${index})
        if(required MATCHES "^/|(^|/)\\.\\.?(/|$)|//|\\\\|:")
            message(FATAL_ERROR "Invalid required file for Storyland vendor ${name}: ${required}")
        endif()
        if(NOT EXISTS "${target}/${required}" OR IS_DIRECTORY "${target}/${required}")
            message(FATAL_ERROR
                "Storyland vendor ${name} is incomplete: vendors/${root}/${required} is missing. "
                "Restore this file from the complete source package or Git checkout.")
        endif()
    endforeach()
    set(${output_variable} "${target}" PARENT_SCOPE)
endfunction()
